{
	// Playground user testing — Worker config.
	//
	// JSONC (not TOML) so the "Deploy to Cloudflare" button can read it to work
	// out what to create for whoever is deploying.
	//
	// worker.js is deployed as it stands: no build step, nothing generated, so
	// what you read is what ships.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "playground-usertest",
	"main": "worker.js",
	"compatibility_date": "2025-01-01",
	"vars": {
		// The card the tester sees. The blueprint route points every test at this
		// one zip, so the card is updated for everybody by changing this.
		"PLUGIN_ZIP_URL": "https://github.com/jamiemarsland/playground-usertest/releases/latest/download/playground-usertest-card.zip",
		// Caps on how much one caller can create, not on how much the service can
		// hold. The KV write ceiling that used to bound this is gone with KV: rows
		// in a database are not rationed by the day.
		"CREATE_DAILY_LIMIT": "5",
		"EVENTS_HOURLY_LIMIT": "300",

		// A per-address cap does nothing about agents: they arrive from shared
		// cloud egress, so one caller's limit becomes everyone's, and anything
		// determined can rotate addresses anyway. This one bounds the store no
		// matter who is asking. Raise it when the service has a name and an owner.
		"GLOBAL_CREATE_DAILY_LIMIT": "200"
	},
	// The service stores everything in SQL behind a D1-shaped binding — what
	// Spacefast's Functions runtime hands a worker, and what D1 gives you here,
	// so the same worker.js runs on either. Without it there is nowhere to put a
	// test and every route answers 503.
	//
	// "local-dev" is a placeholder that keeps `wrangler dev --local` working.
	// Before deploying to Cloudflare, create the database with
	// `wrangler d1 create playground-usertest` and paste the real id over it.
	// The tables are made on first use; there is no migration step.
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "playground-usertest",
			"database_id": "local-dev"
		}
	],
	"observability": {
		"enabled": true
	}
}