{
  // Spacefast Functions: one fetch handler for this space, with env.DB bound to
  // the space's own database.
  //
  // build.sh copies the worker in; nothing else is published, so nothing else
  // is served.
  "$schema": "https://spacefast.com/schemas/sf.json",
  "name": "Playground user testing",
  "runtime": {
    "kind": "functions",
    "entry": "worker.js",

    // Declared, not detected. Without it there is no env.DB and every route
    // answers 503 rather than quietly losing what testers type.
    "database": true
  }
}
